<!doctype html>
<html><body style="font-family:-apple-system,Segoe UI,Helvetica,Arial,sans-serif;font-size:15px;line-height:1.45;color:#111;max-width:640px">
{% if alerts %}
<p>{{ alerts | length }} agenda item{{ "s" if alerts | length != 1 }} matched a normal-priority watchlist since the last digest.</p>
{% else %}
<p>No new matches since the last digest.</p>
{% endif %}
{% for a in alerts %}
<hr style="border:0;border-top:1px solid #ddd;margin:20px 0">
{% include "_alert.html.j2" %}
{% endfor %}
{% if boilerplate %}
<hr style="border:0;border-top:1px solid #ddd;margin:20px 0">
<p><b>Held back as likely boilerplate</b> (the phrase is on more than half of that body's agendas). If one of these should alert, say so and the watchlist can be adjusted:</p>
<ul>
{% for b in boilerplate %}
<li>{{ b }}</li>
{% endfor %}
</ul>
{% endif %}
{% if posted %}
<hr style="border:0;border-top:1px solid #ddd;margin:20px 0">
<p><b>Posted, but Haystack Needle can't read these agendas</b> (the body emails only a notice). Check them by hand:</p>
<ul>
{% for p in posted %}
<li>{% if p.url %}<a href="{{ p.url }}">{{ p.line }}</a>{% else %}{{ p.line }}{% endif %}</li>
{% endfor %}
</ul>
{% endif %}
{% if voted or review or skipped %}
<hr style="border:0;border-top:1px solid #ddd;margin:20px 0">
<p><b>Votes since the last digest</b> (from the Useful and Noise links):</p>
{% if voted %}
<ul>
{% for v in voted %}
<li>{{ v }}</li>
{% endfor %}
</ul>
{% else %}
<p>None.</p>
{% endif %}
{% if skipped %}
<p>{{ skipped }} email{{ "s" if skipped != 1 }} to the votes address didn't count: the subject wasn't a vote's, or its alert is too old.</p>
{% endif %}
{% if review %}
<p><b>Terms to review.</b> The app doesn't change the watchlists; say if one should change:</p>
<ul>
{% for r in review %}
<li>{{ r }}</li>
{% endfor %}
</ul>
{% endif %}
{% endif %}
{% include "_footer.html.j2" %}
</body></html>
