<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}Subscribers · Haystack Admin{% endblock %}</title>
<style>
  :root { --bg: #fbfaf7; --fg: #1d1d1b; --muted: #5f5d57; --line: #d9d6cd; --card: #ffffff;
          --accent: #2f5d8a; --warn-bg: #fbeee2; --warn: #8a3b00; --ok-bg: #e7f2e8; --ok: #245b2c; }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #1b1b1a; --fg: #ecebe6; --muted: #a9a69c; --line: #3a3936; --card: #242422;
            --accent: #8fb6dd; --warn-bg: #3a2a1d; --warn: #f0b58a; --ok-bg: #1f3322; --ok: #9fd3a6; }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--fg); font: 16px/1.5 -apple-system, "Segoe UI", Helvetica, Arial, sans-serif; }
  main { max-width: 820px; margin: 0 auto; padding: 16px 16px 64px; }
  nav { display: flex; gap: 16px; align-items: baseline; border-bottom: 1px solid var(--line); padding: 12px 16px; max-width: 820px; margin: 0 auto; }
  nav strong { margin-right: auto; }
  a { color: var(--accent); }
  h1 { font-size: 24px; margin: 16px 0 8px; }
  h2 { font-size: 18px; margin: 28px 0 8px; }
  .muted { color: var(--muted); }
  .note { background: var(--warn-bg); color: var(--warn); padding: 10px 12px; border-radius: 6px; margin: 12px 0; }
  .ok { background: var(--ok-bg); color: var(--ok); padding: 10px 12px; border-radius: 6px; margin: 12px 0; }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 12px 14px; margin: 10px 0; overflow-wrap: anywhere; }
  .card h3 { margin: 0 0 4px; font-size: 16px; }
  .picks { margin: 2px 0; }
  .actions { display: flex; gap: 16px; align-items: center; margin-top: 6px; }
  .choices { display: flex; flex-wrap: wrap; gap: 4px 18px; margin-top: 6px; }
  .side { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 8px 16px; }
  fieldset { border: 1px solid var(--line); border-radius: 8px; padding: 10px 14px 14px; margin: 14px 0; background: var(--card); }
  legend { font-weight: 600; padding: 0 4px; }
  label { display: block; margin: 10px 0 2px; font-weight: 500; }
  label.check { font-weight: 400; display: flex; gap: 8px; align-items: flex-start; margin: 4px 0; }
  label.check input { margin-top: 5px; }
  .columns { columns: 2 220px; }
  .hint { color: var(--muted); font-size: 14px; margin: 4px 0 0; }
  input[type=text], textarea { width: 100%; max-width: 100%; font: inherit; padding: 6px 8px; border: 1px solid var(--line); border-radius: 6px; background: var(--bg); color: var(--fg); }
  textarea { min-height: 100px; }
  button { font: inherit; padding: 8px 16px; border-radius: 6px; border: 1px solid var(--accent); background: var(--accent); color: var(--bg); cursor: pointer; }
  button.plain { background: transparent; color: var(--accent); padding: 4px 10px; }
  form.inline { display: inline; margin: 0; }
</style>
</head>
<body>
<nav><strong>Haystack Admin</strong><a href="/">Subscribers</a><a href="/person">Add someone</a></nav>
<main>
{% block body %}{% endblock %}
</main>
</body>
</html>
